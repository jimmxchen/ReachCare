{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": { "includeFiles": ["web/**", "planner/**", "data/**", "server.py"], "excludeFiles": "data/snapshots/**", "maxLambdaSize": "100mb" }
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "/api/index.py?__p=/$1" }]
}
