# ReachCare local configuration. Copy to .env (git-ignored) and fill in. Never commit real keys.
# Restart the server after editing:  ./start.sh

# Google Cloud key. Enable "Places API (New)". (The legacy "Geocoding API" is used only as a fallback.)
GOOGLE_MAPS_API_KEY=

# Google AI Studio key (https://aistudio.google.com/apikey).
GEMINI_API_KEY=
# Optional: force a specific Gemini model; otherwise gemini-3.5-flash, gemini-3.1-flash-lite, gemini-flash-latest are tried in order.
# GEMINI_MODEL=

# ElevenLabs key: speech-to-text (Scribe) and multilingual text-to-speech.
ELEVENLABS_API_KEY=
# Optional: voice used for spoken replies (defaults to the premade "Sarah" voice).
# ELEVENLABS_VOICE_ID=

# Photon Spectrum project credentials (iMessage).
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
PHOTON_PROMO_CODE=

# Optional: NCDOT DriveNC key, used only by the legacy planner's road-event feed.
DRIVENC_API_KEY=
